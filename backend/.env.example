# WebGuard Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite:///./webguard.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/webguard

# External Threat Intelligence & Verification API Keys (Optional - mocks used if omitted)
WHOIS_API_KEY=
THREAT_INTEL_API_KEY=
PRICE_API_KEY=

# ML Configuration
ENABLE_ISOLATION_FOREST=true
ML_MODEL_DIR=./ml_models
