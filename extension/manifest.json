{
  "manifest_version": 3,
  "name": "WebGuard: E-Commerce Fraud Risk Assessment",
  "version": "1.0.0",
  "description": "Explainable Multi-Factor E-Commerce Fraud Risk Assessment and Pre-Payment Protection before you enter payment credentials.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/popup/index.html",
    "default_title": "WebGuard Fraud Assessment",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/warning/*", "assets/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
